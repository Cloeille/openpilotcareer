{
  "name": "openpilotcareer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev -w @opc/server",
    "dev:web": "npm run dev -w @opc/web",
    "smoke": "node scripts/smoke.mjs"
  },
  "license": "AGPL-3.0-only",
  "description": "Open-source flight sim career and economy hub",
  "engines": {
    "node": ">=26"
  }
}
