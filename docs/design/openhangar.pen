:"fill_container","content":"De 01 à 09 : les écrans principaux à gauche, les états et cas limites à droite de chaque rangée.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"O6Xqxx","name":"Item · Un viewport de jeu fixe","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"Q5Cdf","name":"Item Title","fill":"$text-primary","content":"Un viewport de jeu fixe","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"LMnKK","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Tous les écrans font 1600 × 900. Ce ne sont pas des pages qui défilent : le contenu tient dans l'écran, le détail passe par des vues secondaires.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"cgwkp","name":"Item · Les références","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"n1XOxX","name":"Item Title","fill":"$text-primary","content":"Les références","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"wYwj0","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"La rangée 10 regroupe la carte des parcours, le schéma d'avion générique et les plans de cabine paramétriques.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"ZaJCG","name":"Item · Les composants","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"Zdien","name":"Item Title","fill":"$text-primary","content":"Les composants","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"DJofS","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Ils sont en haut du canvas, au-dessus de la rangée 01. Toutes les couleurs, polices et rayons sont des variables.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]}]},{"type":"frame","id":"n9FvV","name":"Column · Système de design","width":"fill_container","layout":"vertical","gap":16,"children":[{"type":"text","id":"xSyHp","name":"Column Title","fill":"$text-primary","content":"Système de design","fontFamily":"$font-display","fontSize":22,"fontWeight":"600"},{"type":"frame","id":"dSAe0","name":"Item · Polices","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"SPvki","name":"Item Title","fill":"$text-primary","content":"Polices","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"aslSQ","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Barlow pour le texte, Barlow Semi Condensed pour les titres, B612 Mono (police des cockpits Airbus) pour les codes et les données.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"a9iJOS","name":"Item · Couleur dosée","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"j0hs2","name":"Item Title","fill":"$text-primary","content":"Couleur dosée","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"A5GKe","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Neutre partout. La couleur sert seulement : vert = vérifié, ambre = à surveiller, rouge = rejeté ou hors service, magenta = route active, jaune et noir = panneaux ICAO type taxiway, bleu = PNC et info.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"QHExs","name":"Item · Casse et formats","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"ZkYNX","name":"Item Title","fill":"$text-primary","content":"Casse et formats","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"x4Bik","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Majuscule en début de phrase uniquement ; majuscules réservées aux codes (ICAO, immatriculations, unités). 1 284 560 € · 18:42Z · 1 070 kg · FL240 · 412 kt.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"VxkL7","name":"Item · Composants","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"h3qeH","name":"Item Title","fill":"$text-primary","content":"Composants","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"R2l3h","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Button, Badge, Sign/Location et Sign/Direction, Keycap, Input, Stat, Panel, HUD/Top, HUD/Bottom, View Switcher.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]}]},{"type":"frame","id":"wsxEr","name":"Column · Pour l'implémentation","width":"fill_container","layout":"vertical","gap":16,"children":[{"type":"text","id":"lNveL","name":"Column Title","fill":"$text-primary","content":"Pour l'implémentation","fontFamily":"$font-display","fontSize":22,"fontWeight":"600"},{"type":"frame","id":"RxqDW","name":"Item · Clavier et manette d'abord","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"x5ugI","name":"Item Title","fill":"$text-primary","content":"Clavier et manette d'abord","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"ZhGZs","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Q / E pour les onglets, Échap pour revenir, Entrée pour l'action principale. Voir la carte des parcours en rangée 10.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"emdjb","name":"Item · Deux scripts à reprendre","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"cVt2t","name":"Item Title","fill":"$text-primary","content":"Trois scripts à reprendre","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"S7rRM9","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"scripts/aircraft-schematic.js : avion en nuage de points généré par catégorie. scripts/cabin-layout.js : plan de cabine depuis une configuration JSON. scripts/airport-chart.js : plan 3D d'un aéroport avec ses bâtiments sélectionnables. Du JavaScript simple, réutilisable côté client.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"z3qA6","name":"Item · Images et 3D","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"whAVW","name":"Item Title","fill":"$text-primary","content":"Images et 3D","fontFamily":"$font-ui","fontSize":15,"fontWeight":"600"},{"type":"text","id":"ol9Ci","name":"Item Body","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Les fonds sont des rendus d'illustration ; dans l'app, ce sera une scène temps réel. Flotte, catalogue, achat et comparaison afficheront un vrai modèle 3D (glTF) à sourcer.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":14}]},{"type":"frame","id":"a60Kl5","name":"Item · Données","width":"fill_container","stroke":"$border","strokeWidth":{"top":1},"layout":"vertical","gap":4,"padding":[14,0,0,0],"children":[{"type":"text","id":"krawd","name"