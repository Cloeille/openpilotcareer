{
  "name": "openpilotcareer",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "openpilotcareer",
      "workspaces": [
        "packages/shared",
        "packages/server",
        "packages/web"
      ]
    },
    "node_modules/@opc/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@opc/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@opc/web": {
      "resolved": "packages/web",
      "link": true
    },
    "packages/server": {
      "name": "@opc/server",
      "version": "0.1.0",
      "dependencies": {
        "@opc/shared": "*"
      }
    },
    "packages/shared": {
      "name": "@opc/shared",
      "version": "0.1.0"
    },
    "packages/web": {
      "name": "@opc/web",
      "version": "0.1.0"
    }
  }
}
